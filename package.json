{
	"name": "cms",
	"version": "0.0.1",
	"private": true,
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite build && node server.js",
		"startup": "pnpm i && pnpm add prisma --save-dev && npx prisma generate && npx prisma migrate deploy && pnpm run build && node server.js",
		"test": "npm run test:integration && npm run test:unit",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"test:integration": "playwright test",
		"test:unit": "vitest"
	},
	"devDependencies": {
		"@editorjs/editorjs": "^2.28.2",
		"@editorjs/header": "^2.8.1",
		"@editorjs/image": "^2.9.0",
		"@editorjs/nested-list": "^1.4.2",
		"@iconify/svelte": "^3.1.6",
		"@playwright/test": "^1.40.1",
		"@skeletonlabs/skeleton": "^2.7.0",
		"@skeletonlabs/tw-plugin": "^0.2.4",
		"@sveltejs/adapter-auto": "^2.1.1",
		"@sveltejs/kit": "^1.30.3",
		"@tailwindcss/forms": "^0.5.7",
		"@typescript-eslint/eslint-plugin": "^6.18.1",
		"@typescript-eslint/parser": "^6.18.1",
		"autoprefixer": "^10.4.16",
		"eslint": "^8.56.0",
		"eslint-config-prettier": "^9.1.0",
		"eslint-plugin-svelte": "^2.35.1",
		"postcss": "^8.4.33",
		"postcss-load-config": "^4.0.2",
		"prettier": "^3.2.1",
		"prettier-plugin-tailwindcss": "^0.4.1",
		"prisma": "^5.8.0",
		"sass": "^1.69.7",
		"svelte": "^4.2.8",
		"svelte-check": "^3.6.3",
		"tailwindcss": "^3.4.1",
		"tslib": "^2.6.2",
		"typescript": "^5.3.3",
		"vite": "^4.5.1",
		"vitest": "^0.32.4"
	},
	"type": "module",
	"dependencies": {
		"@lucia-auth/adapter-prisma": "^3.0.2",
		"@prisma/client": "^5.8.0",
		"@sveltejs/adapter-node": "^1.3.1",
		"dotenv": "^16.3.1",
		"express": "^4.18.2",
		"lucia": "^2.7.6",
		"sharp": "^0.32.6",
		"svelte-preprocess": "^5.1.3"
	}
}
