{
	"name": "cms",
	"version": "0.0.1",
	"private": true,
	"scripts": {
		"initialize": "node initialize.js",
		"dev": "vite dev",
		"build": "vite build",
		"preview": "pnpm run initialize && vite build && node server.js",
		"startup": "pnpm i && pnpm add prisma --save-dev && npx prisma generate && npx prisma migrate deploy && pnpm run initialize && pnpm run build && node server.js",
		"prettify": "npx prettier --write .",
		"test": "npm run test:integration && npm run test:unit",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "npx prettier --write . && prettier --check . && eslint .",
		"test:integration": "playwright test",
		"test:unit": "vitest"
	},
	"devDependencies": {
		"@editorjs/editorjs": "^2.30.8",
		"@editorjs/header": "^2.8.8",
		"@editorjs/image": "^2.10.2",
		"@editorjs/nested-list": "^1.4.3",
		"@iconify/svelte": "^4.2.0",
		"@playwright/test": "^1.52.0",
		"@skeletonlabs/skeleton": "^2.11.0",
		"@skeletonlabs/tw-plugin": "^0.2.4",
		"@sveltejs/adapter-auto": "^6.0.0",
		"@sveltejs/kit": "^2.20.7",
		"@tailwindcss/forms": "^0.5.10",
		"@types/nodemailer": "^6.4.17",
		"@types/uuid": "^10.0.0",
		"@typescript-eslint/eslint-plugin": "^8.31.0",
		"@typescript-eslint/parser": "^8.31.0",
		"autoprefixer": "^10.4.21",
		"eslint": "^9.25.1",
		"eslint-config-prettier": "^10.1.2",
		"eslint-plugin-svelte": "^3.5.1",
		"express": "^5.1.0",
		"globals": "^16.0.0",
		"pino-pretty": "^10.3.1",
		"postcss": "^8.5.3",
		"postcss-load-config": "^4.0.2",
		"prettier": "^3.5.3",
		"prettier-plugin-svelte": "^3.3.3",
		"prettier-plugin-tailwindcss": "^0.4.1",
		"prisma": "^6.12.0",
		"sass": "^1.87.0",
		"svelte": "^5.28.2",
		"svelte-check": "^4.1.6",
		"tailwind-scrollbar": "^3.1.0",
		"tailwindcss": "^3.4.17",
		"tslib": "^2.8.1",
		"typescript": "^5.8.3",
		"vite": "^6.3.3",
		"vitest": "^3.1.2"
	},
	"type": "module",
	"dependencies": {
		"@google-analytics/data": "^5.1.0",
		"@lucia-auth/adapter-prisma": "^4.0.1",
		"@prisma/client": "^6.12.0",
		"@sveltejs/adapter-node": "^5.2.12",
		"@sveltejs/vite-plugin-svelte": "^5.0.3",
		"@types/grecaptcha": "^3.0.9",
		"chart.js": "^4.4.9",
		"dotenv": "^16.5.0",
		"lucia": "^3.2.2",
		"node-schedule": "^2.1.1",
		"nodemailer": "^6.10.1",
		"pino": "^9.6.0",
		"sharp": "^0.34.0",
		"svelte-preprocess": "^6.0.3",
		"typescript-eslint": "^8.31.0",
		"uuid": "^11.1.0"
	},
	"engines": {
		"node": ">=23.11.0"
	}
}
