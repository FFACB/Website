{
	"name": "cms",
	"version": "0.0.1",
	"private": true,
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite build && node server.js",
		"startup": "pnpm i && pnpm add prisma --save-dev && npx prisma generate && npx prisma migrate deploy && pnpm run build && node server.js",
		"test": "npm run test:integration && npm run test:unit",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"test:integration": "playwright test",
		"test:unit": "vitest"
	},
	"devDependencies": {
		"@editorjs/editorjs": "^2.29.0",
		"@editorjs/header": "^2.8.1",
		"@editorjs/image": "^2.9.0",
		"@editorjs/nested-list": "^1.4.2",
		"@iconify/svelte": "^3.1.6",
		"@playwright/test": "^1.41.2",
		"@skeletonlabs/skeleton": "^2.8.0",
		"@skeletonlabs/tw-plugin": "^0.2.4",
		"@sveltejs/adapter-auto": "^3.1.1",
		"@sveltejs/kit": "^2.5.0",
		"@tailwindcss/forms": "^0.5.7",
		"@typescript-eslint/eslint-plugin": "^6.21.0",
		"@typescript-eslint/parser": "^6.21.0",
		"autoprefixer": "^10.4.17",
		"eslint": "^8.56.0",
		"eslint-config-prettier": "^9.1.0",
		"eslint-plugin-svelte": "^2.35.1",
		"express": "^4.18.2",
		"pino-pretty": "^10.3.1",
		"postcss": "^8.4.35",
		"postcss-load-config": "^4.0.2",
		"prettier": "^3.2.5",
		"prettier-plugin-tailwindcss": "^0.4.1",
		"prisma": "^5.9.1",
		"sass": "^1.71.0",
		"svelte": "^4.2.11",
		"svelte-check": "^3.6.4",
		"tailwindcss": "^3.4.1",
		"tslib": "^2.6.2",
		"typescript": "^5.3.3",
		"vite": "^5.1.3",
		"vitest": "^0.32.4"
	},
	"type": "module",
	"dependencies": {
		"@lucia-auth/adapter-prisma": "^4.0.0",
		"@prisma/client": "^5.9.1",
		"@sveltejs/adapter-node": "^4.0.1",
		"@sveltejs/vite-plugin-svelte": "^3.0.2",
		"dotenv": "^16.4.5",
		"lucia": "^3.0.1",
		"node-schedule": "^2.1.1",
		"pino": "^8.19.0",
		"sharp": "^0.32.6",
		"svelte-preprocess": "^5.1.3"
	},
	"engines": {
		"node": ">=20.11.1"
	}
}
