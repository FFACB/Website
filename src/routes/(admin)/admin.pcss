
@media only screen and (min-width: 1536px){
    html{
        font-size: 18px; 
    }
}

@media only screen and (max-width: 1280px){
    html{
        font-size: 16px; 
    }
}
@media only screen and (max-width: 1024px){
    html{
        font-size: 14px; 
    }
}

@media only screen and (max-width: 768px){
    html{
        font-size: 12px; 
    }
}

@media only screen and (max-width: 640px){

    html{
        font-size: 10px; 
    }

}